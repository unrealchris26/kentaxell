# Copy to .env for `netlify dev`. Set the same keys in
# Netlify → Site configuration → Environment variables for production.
# .env is gitignored — never commit a real token.

# Settings → Private Integrations → Create
# Scopes required: contacts.write, contacts.readonly
GHL_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sub-account ID. Settings → Business Profile, or the /v2/location/<id>/ URL segment.
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Optional. Automation → Workflows → Inbound Webhook trigger URL.
# Leave blank unless a workflow needs the raw payload as well as the contact.
GHL_WEBHOOK_URL=
