# ── secrets ────────────────────────────────────────────────
# .env holds the live GHL token. Never commit it.
.env
.env.*
!.env.example

# ── build / tooling ────────────────────────────────────────
.netlify/
node_modules/

# Design-hook cache churns on every edit; the config beside it
# carries the reviewed ignore rules and IS tracked.
.impeccable/hook.cache.json

# ── image source originals ─────────────────────────────────
# Full-resolution camera files (6000px, ~65MB). Kept on disk as the
# master copies, but never committed — the web-sized derivatives in
# assets/img/ are what the site actually loads.
assets/img/opt/

# ── OS noise ───────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
